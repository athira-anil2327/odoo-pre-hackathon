# ==============================================================================
# BrightLoop Subscription Management System - Database Configuration
# Local PostgreSQL (SCRAM-SHA-256 Authentication)
# ==============================================================================

# Database Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=brightloop_db
DB_USER=brightloop
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# SQLAlchemy Connection String Formats for FastAPI
# ------------------------------------------------------------------------------

# 1. Standard Synchronous Engine (SQLAlchemy 2.0 + psycopg 3)
# Driver: psycopg (installed version: 3.x)
DATABASE_URL=postgresql+psycopg://brightloop:your_secure_password_here@127.0.0.1:5432/brightloop_db

# 2. Async Engine (SQLAlchemy 2.0 + psycopg 3 async)
# Driver: psycopg_async
ASYNC_DATABASE_URL=postgresql+psycopg_async://brightloop:your_secure_password_here@127.0.0.1:5432/brightloop_db

# 3. Alternative / Legacy psycopg2 Driver (if using psycopg2)
# Driver: psycopg2
# DATABASE_URL=postgresql+psycopg2://brightloop:your_secure_password_here@127.0.0.1:5432/brightloop_db

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_secret_key_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=11520
